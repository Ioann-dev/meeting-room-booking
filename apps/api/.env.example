PORT=4000

# Origin of apps/web, used to build the development email-verification link
# (there is no real SMTP in development; the link is logged instead).
WEB_ORIGIN=http://localhost:3000

# Local dev database (see root docker-compose.yml)
DATABASE_URL=postgresql://app:app@localhost:5432/meeting_room_booking?schema=public

# Separate database used only by the DB/integration test suite, so tests
# never touch development data. The postgres-init script creates this
# database automatically alongside the main one.
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/meeting_room_booking_test?schema=public
