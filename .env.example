# Used by docker-compose.yml. When running Postgres only (the non-Docker
# local setup in README.md), these values must match apps/api/.env's
# DATABASE_URL/TEST_DATABASE_URL.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=meeting_room_booking
POSTGRES_PORT=5432

# Only used by the full `docker compose up` stack (api/web containers
# build DATABASE_URL/WEB_ORIGIN/API_ORIGIN from the values above instead of
# from apps/api/.env -- see docker-compose.yml). Host ports the api/web
# containers publish to, and the notification lead time (see
# NOTIFY_BEFORE_MINUTES in apps/api/.env.example).
API_PORT=4000
WEB_PORT=3000
NOTIFY_BEFORE_MINUTES=10
